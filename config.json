# -*- coding: utf-8 -*-
"""
비트 저장 승인 시스템 - 간호 PC 측 요청 프로그램 (v3)

간호가 미러링 화면에서 처방·차트를 입력한 뒤, 이 창에서 [입력 완료]를 누르면
서브 PC의 승인 대기열로 요청이 들어간다.
저장은 원장님 PC의 버튼으로만 트리거된다.

실행: python nurse_pc_request.py
"""

import json
import os
import threading
import time
import urllib.request
from datetime import datetime

import tkinter as tk
from tkinter import font as tkfont

BASE = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(BASE, "config.json"), encoding="utf-8") as f:
    CFG = json.load(f)

BASE_URL = f"http://{CFG.get('sub_pc_ip', '127.0.0.1')}:{CFG['port']}"
POLL_MS = 1000
st = {"online": False, "pending": 0, "running": False, "halt": None, "last": None,
      "msg": "연결 중…"}


def http_json(path, payload=None, timeout=2.5):
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json; charset=utf-8"
    req = urllib.request.Request(BASE_URL + path, data=data, headers=headers,
                                 method="POST" if data else "GET")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def poll(app):
    while True:
        try:
            s = http_json("/status")
            st.update(online=True, pending=s.get("pending", 0), running=s.get("running", False),
                      halt=s.get("halt"), last=s.get("last"))
            last = s.get("last") or {}
            st["msg"] = (f"최근 #{last.get('id')} " + ("완료" if last.get("ok") else "중단")
                         + f" ({last.get('at')})") if last else "서브 PC 연결됨"
        except Exception as e:  # noqa: BLE001
            st.update(online=False, halt=None, msg=f"서브 PC 연결 안 됨 ({type(e).__name__})")
        app.after(0, app.render)
        time.sleep(POLL_MS / 1000)


class App:
    def __init__(self, root):
        self.root = root
        root.title("비트 · 입력 완료 요청")
        root.geometry("430x300+80+80")
        root.attributes("-topmost", True)
        root.configure(bg="#202124")
        big = tkfont.Font(family="맑은 고딕", size=13, weight="bold")
        small = tkfont.Font(family="맑은 고딕", size=10)

        tk.Label(root, text="환자명 / 차트번호", bg="#202124", fg="#e8eaed",
                 font=small).pack(anchor="w", padx=14, pady=(14, 2))
        self.entry = tk.Entry(root, font=big, bg="#303134", fg="#fff", insertbackground="#fff")
        self.entry.pack(fill="x", padx=14, ipady=6)

        self.slip = tk.BooleanVar(value=CFG["slip"]["default_print"])
        tk.Checkbutton(root, text="슬립지 인쇄", variable=self.slip, bg="#202124", fg="#e8eaed",
                       selectcolor="#303134", activebackground="#202124",
                       activeforeground="#fff", font=small).pack(anchor="w", padx=12, pady=(8, 0))

        tk.Button(root, text="입력 완료  →  원장님 승인 대기로", command=self.send, font=big,
                  bg="#1a73e8", fg="white", activebackground="#1765cc", relief="flat",
                  cursor="hand2").pack(fill="x", padx=14, pady=12, ipady=10)
        self.entry.bind("<Return>", lambda e: self.send())

        self.banner = tk.Label(root, text="—", font=big, bg="#455a64", fg="white")
        self.banner.pack(fill="x", padx=14, ipady=8)
        self.status = tk.Label(root, text="", font=small, bg="#202124", fg="#9aa0a6",
                               anchor="w", justify="left", wraplength=400)
        self.status.pack(fill="x", padx=14, pady=8)
        tk.Label(root, text="※ 입력 완료를 누른 뒤에는 서브 PC 화면을 건드리지 마세요",
                 bg="#202124", fg="#f9ab00", font=small).pack(pady=(0, 6))

        threading.Thread(target=poll, args=(self,), daemon=True).start()

    def send(self):
        name = self.entry.get().strip()
        if not name:
            self.status.config(text="환자명을 입력하세요", fg="#c62828")
            return
        try:
            r = http_json("/enqueue", {"patient": name, "slip_print": bool(self.slip.get())})
            self.entry.delete(0, "end")
            self.status.config(text=f"요청 #{r.get('id')} 전송 완료 — 원장님 승인 대기",
                               fg="#2e7d32")
        except Exception as e:  # noqa: BLE001
            self.status.config(text=f"전송 실패: {type(e).__name__}", fg="#c62828")

    def render(self):
        if not st["online"]:
            self.banner.config(text="서브 PC 연결 안 됨", bg="#37474f")
        elif st["halt"]:
            self.banner.config(text=f"⚠ 원장님 확인 필요 · {st['halt'].get('patient','')}",
                               bg="#f9a825", fg="#212121")
        elif st["running"]:
            self.banner.config(text="저장 실행 중…", bg="#1a73e8")
        elif st["pending"]:
            self.banner.config(text=f"대기 {st['pending']}건", bg="#c62828")
        else:
            self.banner.config(text="대기 없음", bg="#2e7d32")
        self.status.config(text=f"{st['msg']}   ({datetime.now():%H:%M:%S})", fg="#9aa0a6")


if __name__ == "__main__":
    root = tk.Tk()
    App(root)
    root.mainloop()
